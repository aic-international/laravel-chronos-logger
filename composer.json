{
  "name": "aic-international/laravel-chronos-logger",
  "description": "Logging to a chronos server in Laravel",
  "keywords": [
    "laravel",
    "chronos",
    "logging",
    "logger"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Sebastian Pöllath",
      "email": "info@aic-international.de",
      "homepage": "https://aic-international.de/",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "../Backend/vendor/guzzlehttp/guzzle": "^7.0",
    "illuminate/support": "^12.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-master",
    "../Backend/vendor/phpunit/phpunit": "^11.5",
    "../Backend/vendor/mockery/mockery": "^1.0",
    "orchestra/testbench": "^10.0"
  },
  "autoload": {
    "psr-4": {
