{
  "name": "aic-international/laravel-chronos-logger",
  "description": "Logging to a chronos server in Laravel",
  "keywords": [
    "laravel",
    "chronos",
    "logging",
    "logger"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Sebastian Pöllath",
      "email": "info@aic-international.de",
      "homepage": "https://aic-international.de/",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "illuminate/support": "^10.0|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "AicInternational\\ChronosLogger\\": "src/ChronosLogger"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AicInternational\\ChronosLogger\\ServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable"
}
